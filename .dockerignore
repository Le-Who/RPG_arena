# ─────────────────────────────────────────────
#  Chronicle Engine — .dockerignore
#  Исключаем всё лишнее из Docker build context
#  для быстрой сборки и безопасного образа.
# ─────────────────────────────────────────────


# ══════════════════════════════════════════════
#  NODE / PACKAGE MANAGERS
# ══════════════════════════════════════════════
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.js
.yarn/


# ══════════════════════════════════════════════
#  NEXT.JS BUILD ARTIFACTS
# ══════════════════════════════════════════════
# .next/ добавляется в образ только при standalone-билде.
# При обычном npm run build внутри Dockerfile — не нужно.
.next/
out/
build/
dist/
.turbo/


# ══════════════════════════════════════════════
#  ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ — НИКОГДА в образ!
# ══════════════════════════════════════════════
.env
.env.*
!.env.example


# ══════════════════════════════════════════════
#  GIT
# ══════════════════════════════════════════════
.git/
.gitignore
.gitattributes


# ══════════════════════════════════════════════
#  ДОКУМЕНТАЦИЯ И МЕТАДАННЫЕ
# ══════════════════════════════════════════════
README.md
CHANGELOG.md
CONTRIBUTING.md
LICENSE
docs/
*.md


# ══════════════════════════════════════════════
#  ТЕСТЫ
# ══════════════════════════════════════════════
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
coverage/
playwright-report/
test-results/


# ══════════════════════════════════════════════
#  РЕДАКТОРЫ И IDE
# ══════════════════════════════════════════════
.vscode/
.idea/
*.swp
*.swo
*~


# ══════════════════════════════════════════════
#  ОПЕРАЦИОННЫЕ СИСТЕМЫ
# ══════════════════════════════════════════════
.DS_Store
Thumbs.db
Desktop.ini


# ══════════════════════════════════════════════
#  DRIZZLE
# ══════════════════════════════════════════════
# Drizzle config содержит credentials — исключаем
drizzle.config.json
drizzle.config.ts


# ══════════════════════════════════════════════
#  ПРОЧЕЕ
# ══════════════════════════════════════════════
*.log
logs/
.eslintcache
.prettiercache
.stylelintcache
*.tsbuildinfo
Dockerfile*
docker-compose*.yml
.dockerignore
