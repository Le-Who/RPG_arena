{
  "name": "nextjs-postgresql-template",
  "private": true,
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:deploy": "npm run migrate && npm run build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./tests/helpers/test-environment.ts --test --test-concurrency=1 tests/*.test.ts",
    "test:coverage": "node -e \"require('node:fs').mkdirSync('output',{recursive:true})\" && node --import tsx --import ./tests/helpers/test-environment.ts --experimental-test-coverage --test-coverage-include=src/** --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=output/test-coverage.lcov tests/*.test.ts",
    "test:quota:postgres": "node --import tsx --test tests/integration/quota-postgres.integration.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "worker": "node --env-file=.env --import tsx scripts/memory-worker.ts",
    "audit:ui": "node --env-file-if-exists=.env --import tsx scripts/ui-audit.ts",
    "verify:ui": "node --env-file-if-exists=.env --import tsx scripts/ui-verify.ts",
    "smoke": "node --env-file=.env --import tsx scripts/smoke.ts",
    "smoke:v22": "node --env-file=.env --import tsx scripts/v22-smoke.ts",
    "verify": "npm run typecheck && npm run test && npm run build",
    "verify:story-ui": "node --env-file-if-exists=.env --import tsx scripts/story-experience-browser.ts",
    "verify:visual-gallery-ui": "node --import tsx --import ./tests/helpers/test-environment.ts scripts/visual-gallery-browser.ts",
    "verify:revisions-ui": "node --import tsx scripts/revisions-browser.ts",
    "eval:story-drafts": "node --env-file-if-exists=.env --import tsx scripts/eval-story-drafts.ts",
    "eval:typesafe": "node --env-file-if-exists=.env --import tsx scripts/eval-typesafe.ts",
    "rotate:secrets": "node --env-file-if-exists=.env --import tsx scripts/rotate-secrets.ts",
    "check:docs": "node --import tsx scripts/check-docs.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.47.0",
    "next": "~16.4.2",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "^4.23.13"
  },
  "overrides": {
    "braces": "$braces"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.1",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@next/eslint-plugin-next": "16.4.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "8.71.2",
    "braces": "file:./tooling/braces",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "postcss": "^8.5.28",
    "semver": "7.8.5",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
