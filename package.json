{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:deploy": "npm run migrate && npm run build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./tests/helpers/test-environment.ts --test --test-concurrency=1 tests/*.test.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "worker": "node --env-file=.env --import tsx scripts/memory-worker.ts",
    "audit:ui": "node --env-file-if-exists=.env --import tsx scripts/ui-audit.ts",
    "verify:ui": "node --env-file-if-exists=.env --import tsx scripts/ui-verify.ts",
    "smoke": "node --env-file=.env --import tsx scripts/smoke.ts",
    "smoke:v22": "node --env-file=.env --import tsx scripts/v22-smoke.ts",
    "verify": "npm run typecheck && npm run test && npm run build",
    "verify:story-ui": "node --env-file-if-exists=.env --import tsx scripts/story-experience-browser.ts",
    "eval:story-drafts": "node --env-file-if-exists=.env --import tsx scripts/eval-story-drafts.ts",
    "eval:typesafe": "node --env-file-if-exists=.env --import tsx scripts/eval-typesafe.ts",
    "rotate:secrets": "node --env-file-if-exists=.env --import tsx scripts/rotate-secrets.ts",
    "check:docs": "node --import tsx scripts/check-docs.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.63.0",
    "baseline-browser-mapping": "^2.11.25",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
