# PostgreSQL, required. Local development defaults only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional server-side Gemini keys. Never use NEXT_PUBLIC_ for secrets.
GEMINI_API_KEYS=
# GEMINI_API_KEY=

# Optional Jev shadow verifier. Server value overrides the key stored in settings.
# Pilot is disabled by default; enable in Settings > Для разработки.
TYPESAFE_API_KEY=

# Optional target for test scripts; the application must already be running.
SMOKE_BASE_URL=http://localhost:3000
