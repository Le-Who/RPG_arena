# PostgreSQL, required. Local development defaults only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional keys for offline evaluation scripts only. The website uses each
# visitor's own Gemini settings and never borrows shared Gemini keys.
# Never use NEXT_PUBLIC_ for secrets.
GEMINI_API_KEYS=
# GEMINI_API_KEY=

# Optional Jev key for offline evaluation scripts only (not website profiles).
# Pilot is disabled by default; enable in Settings > Для разработки.
TYPESAFE_API_KEY=

# Optional shared Jev credentials, explicitly authorized for website fallback.
# Personal verification keys take precedence. Never exposed to browsers.
# If both are set, OpenRouter is preferred. No keys means no Jev check.
NARRATIVE_ADMIN_OPENROUTER_API_KEY=
NARRATIVE_ADMIN_TYPESAFE_API_KEY=

# Optional target for test scripts; the application must already be running.
SMOKE_BASE_URL=http://localhost:3000
