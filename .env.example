# PostgreSQL, required. Local development defaults only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional keys for offline evaluation scripts only. The website uses each
# visitor's own Gemini settings and never borrows shared Gemini keys.
# Never use NEXT_PUBLIC_ for secrets.
GEMINI_API_KEYS=
# GEMINI_API_KEY=

# Optional Jev key for offline evaluation scripts only (not website profiles).
# Pilot is disabled by default; enable in Settings > Для разработки.
TYPESAFE_API_KEY=

# Optional shared Jev credentials, explicitly authorized for website fallback.
# Personal verification keys take precedence. Never exposed to browsers.
# If both are set, OpenRouter is preferred. No keys means no Jev check.
NARRATIVE_ADMIN_OPENROUTER_API_KEY=
NARRATIVE_ADMIN_TYPESAFE_API_KEY=

# Optional target for test scripts; the application must already be running.
SMOKE_BASE_URL=http://localhost:3000

# Required before saving personal provider credentials. Values are server-only.
# Generate each 32-byte key with: openssl rand -base64 32
# In .env, quote the complete JSON value so the loader preserves it.
CHRONICLE_SECRET_ACTIVE_KEY=
CHRONICLE_SECRET_KEYS=
# Temporary migration-only opt-in. Prefer `npm run rotate:secrets -- --apply --allow-plaintext`.
# CHRONICLE_ALLOW_LEGACY_PLAINTEXT=false
## Optional startup migrations for web and worker; failure blocks startup. Prefer explicit deploy migration.
CHRONICLE_AUTO_MIGRATE=0
# Server-only account UUID allowlist. Empty means no administrators; never use guest profile IDs.
CHRONICLE_ADMIN_ACCOUNT_IDS=
# Optional exact public origin (no trailing slash), especially behind a TLS reverse proxy.
CHRONICLE_PUBLIC_ORIGIN=
# Set only when trusted ingress overwrites this client-address header and bypass access is blocked.
CHRONICLE_AUTH_TRUSTED_CLIENT_HEADER=

# VIS-1/2: manual scene illustrations (not canon). Current Pollinations API requires
# a server-only key for generation via gen.pollinations.ai. Never use NEXT_PUBLIC_.
POLLINATIONS_API_KEY=
# CHRONICLE_VISUAL_PROVIDER=pollinations
# Initial fallback until an admin saves a choice on /system/visuals.
# CHRONICLE_VISUAL_MODEL=tongyi-mai/z-image-turbo
# CHRONICLE_VISUAL_DAILY_LIMIT=40
# CHRONICLE_VISUALS_DISABLED=0
