# Database connection string (PostgreSQL 14+)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Optional: Gemini API keys from environment (comma-separated). Merged with keys stored via /settings.
# GEMINI_API_KEYS="AIza...,AIza..."

# Optional: fail process start if migrations fail (default: fail-open with error in logs and /api/health)
# MIGRATIONS_STRICT=1
