# ─────────────────────────────────────────────
#  Chronicle Engine — .gitignore
#  Стек: Next.js 16 · TypeScript · Tailwind v4
#         Drizzle ORM · PostgreSQL · Node 22
# ─────────────────────────────────────────────


# ══════════════════════════════════════════════
#  ЗАВИСИМОСТИ
# ══════════════════════════════════════════════
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz


# ══════════════════════════════════════════════
#  NEXT.JS
# ══════════════════════════════════════════════
.next/
out/
build/
dist/

# Артефакты Turbopack
.next/cache/
.turbo/


# ══════════════════════════════════════════════
#  ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ — никогда не коммитить!
# ══════════════════════════════════════════════
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging

# Исключение: шаблон для документирования переменных
!.env.example


# ══════════════════════════════════════════════
#  DRIZZLE ORM
# ══════════════════════════════════════════════
# Миграции генерируются автоматически — исключать
# нецелесообразно, если хранишь их в репо.
# Раскомментируй строку ниже если миграции авто-генерируются в CI:
# drizzle/

# Временные файлы drizzle-kit
drizzle/.meta/

# ⚠️  drizzle.config.json содержит hardcoded credentials БД —
#    НИКОГДА не коммитить! Использовать .env + drizzle.config.ts с process.env
drizzle.config.json


